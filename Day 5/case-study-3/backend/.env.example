# Copy to .env and adjust as needed. Nothing secret belongs here - the LLM
# API key is BYOK, supplied per-request in the /documents/{id}/extract body
# and never persisted or logged.

CORS_ORIGIN=http://localhost:5174

# Single hardcoded demo admin account (see app/auth.py) - not a real user
# system. Change these if you don't want the published defaults active.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

DATABASE_URL=sqlite:///./app.db

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=data_element_specs
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SPECS_DIR=./app/rag/specs

DEFAULT_LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20

OTEL_SERVICE_NAME=carta-extraction-backend
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4327
OTEL_ENABLED=true
