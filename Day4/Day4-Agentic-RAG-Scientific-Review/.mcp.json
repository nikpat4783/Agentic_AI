{
  "mcpServers": {
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {}
    },
    "app-dev-orchestrator": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR:-.}/mcp-server/.venv/bin/python",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/mcp-server/server.py"
      ],
      "env": {}
    }
  }
}